# Copy to .env.local beside the selected config.yaml. Process environment overrides this file.
# Text inference credentials are loaded only by the server; never add them to frontend VITE_ settings.
EXPERT_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# glm-4.7 is billed by the provider. Select glm-4.7-flash explicitly to use the free model.
EXPERT_AGENT_MODEL=glm-4.7
EXPERT_AGENT_API_KEY=
